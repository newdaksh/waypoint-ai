# Copy to server/.env and fill in. `npm run dev` / `npm start` load it automatically.
# Variable names are matched ignoring case, so GEMINI_API_KEY and gemini_api_key both work.

# Required. MongoDB is the only database: your workspace (resume, jobs, applications, results) lives there.
# Atlas: Database → Connect → Drivers. On Atlas also allow your IP under Network Access.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/
MONGODB_DB=waypoint_ai

# Required for every AI feature. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Model used for every AI task. Leave blank to use the default, gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# Accounts & password-reset email -------------------------------------------
# The address users open the app at. Reset links in emails point here (dev: the Vite server).
# APP_URL=http://localhost:5173
# Without SMTP, no email is sent: the reset link is printed in this server's console instead.
# Example (Gmail with an app password; for others use their SMTP host):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=Waypoint <you@gmail.com>
# LOCAL DEVELOPMENT ONLY: return the reset link in the API response so the forgot-password page can show it.
# Ignored when NODE_ENV=production. Never enable on a server other people can reach.
# AUTH_DEV_RESET_LINKS=true
# Behind a reverse proxy / load balancer (so client IPs and HTTPS are detected correctly): TRUST_PROXY=1
# Force the Secure flag on the session cookie (automatic when APP_URL starts with https): COOKIE_SECURE=true

# Optional ---------------------------------------------------------------
# PORT=4000
# There is no login: by default the API only listens on this machine. Only change this if you
# understand that anyone who can reach the port can read the workspace and spend your API quota.
# HOST=127.0.0.1
# GEMINI_TIMEOUT_MS=120000
# Comma-separated origins allowed by CORS (not needed in dev: Vite proxies /api)
# CORS_ORIGIN=
